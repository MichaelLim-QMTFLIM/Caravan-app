# Required for the Turso/libSQL database connection.
TURSO_LINK=libsql://your-database.turso.io
TURSO_TOKEN=replace-with-your-turso-auth-token

# Use a long, random value. Never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

PORT=3000
NODE_ENV=development

# Optional: Google sign-in configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Optional: Mailgun configuration (email route is currently disabled).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
